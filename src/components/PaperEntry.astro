---
import { splitAuthors, type Paper } from '../lib/data';

interface Props {
  paper: Paper;
  index?: number;
}

const { paper, index } = Astro.props;
const authors = splitAuthors(paper.authors);
---

<li class:list={["paper", { unnumbered: index === undefined }]}>
  {index !== undefined && <span class="paper-num tnum" aria-hidden="true">[{index}]</span>}
  <div>
    <p class="paper-title">{paper.title}</p>
    <p class="paper-meta">
      {
        authors.map((a, i) => (
          <>
            {a.isMe ? <strong>{a.text}</strong> : a.text}
            {i < authors.length - 1 ? ', ' : ''}
          </>
        ))
      }
      . <em>{paper.venue}</em>{paper.details ? `, ${paper.details}` : ''}, {paper.year}.
      {paper.note && <span> {paper.note}</span>}
    </p>
    <p class="paper-links">
      {paper.doi && <a href={`https://doi.org/${paper.doi}`}>doi:{paper.doi}</a>}
      {paper.project && <a href={`/projects/${paper.project}/`}>Project page</a>}
      {paper.code && <a href={paper.code}>Code</a>}
    </p>
  </div>
</li>

<style>
  .paper {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--space-2);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--rule);
  }
  .paper.unnumbered {
    grid-template-columns: minmax(0, 1fr);
  }
  .paper-num {
    color: var(--muted);
    font-size: var(--type-meta);
    padding-top: 0.15rem;
  }
  .paper-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.3;
    margin-bottom: var(--space-1);
    max-width: 60ch;
  }
  .paper-meta {
    font-size: var(--type-meta);
    color: var(--muted);
    margin-bottom: var(--space-1);
    max-width: 62ch;
  }
  .paper-meta strong {
    color: var(--text);
    font-weight: 600;
  }
  .paper-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    font-size: var(--type-meta);
    margin: 0;
  }
  .paper-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    word-break: break-all;
  }
  @media (max-width: 47.99rem) {
    .paper {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
